# Copy to .env and fill in. NEVER commit .env.
#
# The keeper's signing key, only needed for --execute. This wallet holds gas, imdUSD liquidation
# inventory and (optionally) IMD for oracle requests. It is a HOT key: assume anything on this machine is
# compromised eventually, keep only an operating balance here, and use a fresh wallet for nothing else.
# Keep the quotes: a 12/24-word phrase has spaces. Make one with `cast wallet new-mnemonic`.
KEEPER_MNEMONIC=""

# Where signed transactions are sent. Use a private mempool so a bite is not front-run:
#   https://rpc.mevblocker.io   or   https://rpc.flashbots.net
# VAULT_RPC_URL=

# Reads, comma-separated, tried in order (default: publicnode, then drpc).
# READ_RPC_URLS=

# The deployment record (default: the mainnet record shipped in this repo).
# DEPLOYMENT=./deployment/mainnet/deployment.json

# Blockscout API key for position discovery past the anonymous quota (https://eth.blockscout.com).
# BLOCKSCOUT_API_KEY=
