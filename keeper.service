# systemd unit template. Install as a USER unit so the keeper never runs as root:
#
#   mkdir -p ~/imdusd-keeper/state ~/.config/systemd/user   # ReadWritePaths below must exist
#   cp keeper.service ~/.config/systemd/user/imdusd-keeper.service
#   # edit WorkingDirectory and ExecStart below
#   loginctl enable-linger $USER
#   systemctl --user daemon-reload
#   systemctl --user enable --now imdusd-keeper
#   journalctl --user -u imdusd-keeper -f
#
# Report-only until you add --execute. Start it without, read a few cycles, then decide.
[Unit]
Description=imdUSD keeper: oracle watcher, attestation relayer, liquidator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/imdusd-keeper
EnvironmentFile=-%h/imdusd-keeper/.env
ExecStart=/usr/bin/env node index.mjs
Restart=always
RestartSec=30
# The key is in the environment, so keep the process from writing it anywhere it need not.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/imdusd-keeper/state

[Install]
WantedBy=default.target
